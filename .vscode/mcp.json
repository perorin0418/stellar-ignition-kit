{
    "servers": {
        "serena": {
            "command": "uvx",
            "args": [
                "--from",
                "git+https://github.com/oraios/serena",
                "serena",
                "start-mcp-server",
                "--context",
                "ide-assistant"
            ]
        },
        "git": {
            "command": "uvx",
            "args": [
                "mcp-server-git"
            ]
        },
        "drawio": {
            "command": "npx",
            "args": [
                "-y",
                "@drawio/mcp"
            ]
        }
    },
    "inputs": []
}